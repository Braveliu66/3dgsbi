 		}
 }
 
+void fastgs_accumulate_metrics(
+	const torch::Tensor& visible,
+	const float view_score,
+	const float metric_weight,
+	torch::Tensor& score_sum,
+	torch::Tensor& metric_counts)
+{
+	TORCH_CHECK(score_sum.numel() == metric_counts.numel(), "score_sum and metric_counts must have the same number of elements");
+	TORCH_CHECK(visible.numel() == score_sum.numel(), "visible must have one entry per Gaussian metric row");
+	TORCH_CHECK(score_sum.device() == metric_counts.device(), "score_sum and metric_counts must be on the same device");
+	TORCH_CHECK(visible.device() == score_sum.device(), "visible and metric buffers must be on the same device");
+
+	auto weights = visible.reshape({-1, 1}).to(score_sum.scalar_type());
+	score_sum.add_(weights.mul(view_score));
+	metric_counts.add_(weights.mul(metric_weight));
+}
